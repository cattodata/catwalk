# =============================================================================
# Catto Compass — environment variables
# Copy this file to `.env.local` and fill values.
# `.env.local` is git-ignored.
# =============================================================================

# ----- LLM provider (one of two — Azure preferred when both set) --------------
#
# Option A: Anthropic Claude Sonnet 4 (matches spec, ~$3/$15 per 1M tokens)
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Option B: Azure OpenAI gpt-4o (uses Visual Studio Azure credit if available)
# Provision via the `azure-openai-personal` skill (Pattern B per-project resource)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ----- Supabase --------------------------------------------------------------
# Create project at https://supabase.com → Settings → API
# These ARE prefixed VITE_ — Supabase anon key is safe in browser (RLS enforced)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (used by future /api/* routes that bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=
