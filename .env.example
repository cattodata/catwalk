# =============================================================================
# Catto Compass — environment variables
# Copy this file to `.env.local` and fill values.
# `.env.local` is git-ignored.
# =============================================================================

# ----- Anthropic Claude (server-side only — used by /api/claude) ---------------
# Get from https://console.anthropic.com/
# IMPORTANT: never prefix with VITE_ — that would expose to browser bundle
ANTHROPIC_API_KEY=

# ----- Supabase --------------------------------------------------------------
# Create project at https://supabase.com → Settings → API
# These ARE prefixed VITE_ — Supabase anon key is safe in browser (RLS enforced)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (used by future /api/* routes that bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=
